# This file defines the variables and parameters needed to AUTO computations. 
# The descriptions are taken directly from the AUTO-07 Manual (see README section 7 for reference) 

#Parameter                  Description
#----------------           -----------
e = 'common_model'          # File name
NDIM = 6                    # Number of dimensions
NPAR = 19                   # Number of parameters
IPS = 1                     # Stationary solutions of ODEs with detection of Hopf bifurcations.
IRS = 0                     # This constant sets the label of the solution where the computation is to be restarted. 
ILP = 1                     # Detection of folds. To be used if subsequent fold continuation is intended
ICP = [14]                  # Parameter allowed to vary (in this case fishing effort mu)
NTST = 20                   # Number of mesh intervals used for discretization (as small as possible to maintain convergence)
NCOL = 4                    # Number of Gauss collocation points per mesh interval (4 recommended)
IAD = 3                     # Adapt the mesh every IAD steps along the family (3 recommended)
ISP = 2                     # Problem type: Time integration using implicit Euler
ISW = 1                     # This constant controls branch switching at branch points. (1 is normal value) 
IPLT = 0                    # L2 norm is printed as the second real column in the screen output and in the 'fort.7' output file
NBC = 0                     # The number of boundary conditions as specified in the user-supplied routine BCND (not used)
NINT = 0                    # The number of integral conditions as specified in the user-supplied routine ICND (not used)
NMX = 1000                  # The maximum number of steps to be taken along any family
NPR = 50                    # Save an ordinary restart point every 50 steps
MXBF = 10                   # Sets the maximum number of bifurcations to be treated (algebraic problems only)
IID = 2                     # The greater the IID the more detailled the diagnostic output (2 is regular)
ITMX = 10                   # The maximum number of iterations allowed for special solutions (8 = recommended)
ITNW = 9                    # The maximum number of combined Newton-Chord iterations. 
NWTN = 7                    # After NWTN Newton iterations the Jacobian is frozen                       
JAC = 0                     # No derivatives are given by the user 
EPSL = 1e-8                 # Relative convergence criterion in the Newton/Chord method (10e-7 recommended)
EPSU = 1e-8                 # Relative convergence criterion in the Newton/Chord method (10e-7 recommended)
EPSS = 1e-6                 # Relative arclength convergence criterion for the detection of special solutions(5e-7 recommended)
DS = 0.0005                 # Pseudo-arclength stepsize: distance between the current solution and the next solution on a family
DSMIN = 0.0001              # This is minimum allowable absolute value of the pseudo-arclength stepsize
DSMAX = 0.05                # The maximum allowable absolute value of the pseudo-arclength stepsize
IADS = 1                    # Controls the frequency of adaption of the pseudo-arclength stepsize (after every IADS steps)
RL0 = -0.25                 # The lower bound on the principal continuation parameter
RL1 = 0.5                   # The upper bound on the principal continuation parameter
A0 = 0.0                    # The lower bound on the principal solution measure
A1 = 100.0                  # The upper bound on the principal solution measure.
UZR = {}                    # Allows the setting of parameter values at which labeled plotting and restart information is written
UZSTOP = {14: [-0.25, 0.5]} # stop and save a UZ point when mu reaches −0.25 or 0.5.
SP = ['BP', 'LP', 'HB']     # Detect branch points, folds, and Hopf bifurcations.
STOP = []                   # Do not stop at any numbered bifurcation.

# Changes the names in all output. Allows us to refer to these strings instead of the corresponding indices. 
parnames = {1: 'r', 2: 'a', 3: 'm', 4: 'b', 5: 's', 6: 'e', 7: 'fec', 8: 'g', 9: 'q', 10: 'c', 12: 'dF', 13: 'dJ', 14: 'mu', 15: 'deltar', 16: 'deltas', 17: 'beta', 18: 'toggle', 19: 'dP'}
unames = {1: 'PL', 2: 'FL', 3: 'JL', 4: 'PP', 5: 'FP', 6: 'JP'}
